#!/usr/bin/env sh
MAVEN_PROJECTBASEDIR="$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd)"
export MAVEN_PROJECTBASEDIR
WRAPPER_DIR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper"
if [ -n "$MAVEN_HOME" ] && [ -x "$MAVEN_HOME/bin/java" ]; then
  JAVA_CMD="$MAVEN_HOME/bin/java"
elif [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA_CMD="$JAVA_HOME/bin/java"
else
  JAVA_CMD="java"
fi
exec "$JAVA_CMD" -jar "$WRAPPER_DIR/maven-wrapper.jar" "$@"